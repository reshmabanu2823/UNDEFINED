# NULL//ROOT ENVIRONMENT CONFIGURATION
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite async)
# Default is async SQLite for immediate local plug-and-play, or replace with PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/null_root
DATABASE_URL=sqlite+aiosqlite:///./null_root.db

# JWT Security Credentials (Replace with strong secret in production)
JWT_SECRET=null_root_secret_key_neural_link_override_0x9f2a
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:4173"]
